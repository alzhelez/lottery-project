# Скопируйте в .env и заполните при необходимости. Все переменные необязательны.

# Путь к Python. По умолчанию ищется .venv в папке проекта, затем ~/.venv, затем python/python3.
# PYTHON_BIN=C:\lottery-project\.venv\Scripts\python.exe

# Доступ к API Столото. Если загрузка падает с HTTP 401/403 — откройте stoloto.ru в браузере,
# DevTools → Network → запрос draws/archive и скопируйте заголовки gosloto-token и Cookie.
# STOLOTO_TOKEN=
# STOLOTO_COOKIE=
# STOLOTO_GAMES_TOKEN=

# Пауза между запросами к API, секунд (по умолчанию 0.2)
# STOLOTO_DELAY=0.2

# Папка данных (по умолчанию ./data)
# LOTTERY_DATA_DIR=

# Папка резервных копий журнала и моих билетов (по умолчанию backup рядом с папкой данных)
# LOTTERY_BACKUP_DIR=

# ── Уведомления в Telegram (необязательно) ──────────────────────────────────
# 1) В Telegram откройте @BotFather → /newbot → получите токен и впишите сюда.
# 2) Откройте своего бота и нажмите «Запустить».
# 3) lp.bat telegram setup — сам найдёт id чата и допишет TELEGRAM_CHAT_ID.
# 4) lp.bat telegram test — тестовое сообщение.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Какие события присылать: journal (сверка прогнозов), auto (итог автозапуска), godmode, errors,
# drift (игра начала отклоняться от случайности в последних тиражах), ev (ближайший тираж выгоднее порога)
# TELEGRAM_EVENTS=journal,auto,godmode,errors,drift,ev,tickets
# Порог для события ev: ожидаемый возврат ближайшего тиража на 1 ₽ ставки (1 = окупает ставку в среднем)
# TELEGRAM_EV_THRESHOLD=1
# Если api.telegram.org недоступен напрямую — прокси (для socks5 нужен: pip install pysocks)
# TELEGRAM_PROXY=socks5://127.0.0.1:1080
