{
  "name": "lottery-predictor",
  "version": "40.4.0",
  "private": true,
  "description": "Анализ тиражей Столото: тесты случайности, честная проверка методов прогноза, режим Бога",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "test:py": "python -m pytest tests/pytest",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "test:py:allure": "python -m pytest tests/pytest --alluredir=allure-results/python",
    "test:api:env": "python tests/api/env.py start",
    "test:api:env:stop": "python tests/api/env.py stop",
    "test:api:py": "python -m pytest tests/api/python --alluredir=allure-results/api-python",
    "test:api:go": "cd tests/api/go && go test -count=1 -json ./... | go run ./cmd/gojunit -src . -out ../../../allure-results/api-go/junit.xml",
    "test:api:java": "mvn -q -f tests/api/java/pom.xml test",
    "test:api": "python tests/api/env.py run -- npm run test:api:py",
    "allure:report": "node tools/allure-report.mjs",
    "allure:open": "allure open allure-report"
  },
  "dependencies": {
    "next": "16.1.3",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "@types/node": "22.10.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "allure": "3.20.1",
    "allure-playwright": "3.11.0",
    "typescript": "5.7.2"
  }
}
